# Anland (Wayland) di dalam container Droidspaces.
# KWin Anland butuh DRM render node (/dev/dri/renderD128). Kernel msm8937 tidak
# punya driver display DRM, jadi dipakai vgem (node DRM virtual) sebagai
# pengganti. Node render-nya muncul berkat patches/0003-drm-vgem-enable-render-node.patch.
# Mesa memakai GPU lewat /dev/kgsl-3d0 (FD_FORCE_KGSL=1); node DRM hanya fd kontrol.
CONFIG_DRM=y
CONFIG_DRM_VGEM=y

# Syscall kcmp, dipakai Mesa untuk membandingkan fd
# ("os_same_file_description ... Function not implemented"). Opsional.
CONFIG_CHECKPOINT_RESTORE=y
