# BakaSU (KernelSU downstream) - manual hook mode, no SUSFS.
# Replaces the bundled KernelSU-Next + SUSFS fragments
# (vendor/feature/ksu_susfs.config, ksu_static_hooks.config), which must NOT
# be used together with BakaSU.
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_SUSFS is not set
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y

# BakaSU skips its "static symbol export" check only when KALLSYMS_ALL=y
# (already set in msm8937-perf_defconfig; kept explicit on purpose).
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
