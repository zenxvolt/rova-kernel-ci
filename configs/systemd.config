# Kernel options a modern systemd (258-262) guest needs on this 4.19 tree.
# Goes together with patches/systemd/*.patch (droidspaces-backports, 4.19 series).
# Only options that msm8937-perf_defconfig leaves off are listed here.

# open_by_handle_at()/name_to_handle_at(): systemd's mount and unit tracking.
CONFIG_FHANDLE=y

# AF_ALG hash sockets (HMAC and SHA256 are already enabled in the base config).
CONFIG_CRYPTO_USER_API_HASH=y

# autofs: automount units. 4.19 names it AUTOFS_FS (AUTOFS4_FS is a compat alias).
CONFIG_AUTOFS_FS=y
