drm/vgem: enable render node

vgem in 4.19 registers only a primary node (/dev/dri/card0). Userspace that
needs a DRM *render* node (KWin Anland backend via ANLAND_DRM_DEVICE, Mesa EGL
surfaceless device probing) finds nothing. The ioctls are already marked
DRM_RENDER_ALLOW, so only the driver feature flag is missing.

diff --git a/drivers/gpu/drm/vgem/vgem_drv.c b/drivers/gpu/drm/vgem/vgem_drv.c
index 0e5620f..b5644e7 100644
--- a/drivers/gpu/drm/vgem/vgem_drv.c
+++ b/drivers/gpu/drm/vgem/vgem_drv.c
@@ -431,7 +431,7 @@ static void vgem_release(struct drm_device *dev)
 }
 
 static struct drm_driver vgem_driver = {
-	.driver_features		= DRIVER_GEM | DRIVER_PRIME,
+	.driver_features		= DRIVER_GEM | DRIVER_PRIME | DRIVER_RENDER,
 	.release			= vgem_release,
 	.open				= vgem_open,
 	.postclose			= vgem_postclose,
